{
  "name": "@monnify/mcp-server",
  "version": "1.0.0",
  "description": "Production-grade MCP server for Monnify payment APIs — TypeScript, OpenAPI-driven",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-server": "./build/cli.js"
  },
  "files": [
    "build/",
    "openapi/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x build/cli.js",
    "start": "node build/index.js",
    "start:cli": "node build/cli.js",
    "dev": "tsx watch src/index.ts",
    "generate": "bash scripts/generate-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "dotenv": "^16.5.0",
    "express": "^4.19.0",
    "winston": "^3.14.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.0.0",
    "openapi-zod-client": "^1.18.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["monnify", "mcp", "payments", "nigeria", "fintech", "llm-agents"],
  "license": "MIT"
}
