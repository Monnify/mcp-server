# ─────────────────────────────────────────────
# Monnify API Credentials
# Obtain from: Monnify Dashboard → Settings → API Keys
# ─────────────────────────────────────────────
MONNIFY_API_KEY=your_api_key_here
MONNIFY_SECRET_KEY=your_secret_key_here
MONNIFY_CONTRACT_CODE=your_contract_code_here

# ─────────────────────────────────────────────
# Environment targeting
# MONNIFY_ENV and MONNIFY_BASE_URL MUST match.
# The server validates this at startup and exits if they conflict.
# ─────────────────────────────────────────────
MONNIFY_ENV=sandbox
MONNIFY_BASE_URL=https://sandbox.monnify.com

# For production — uncomment both lines together, never mix:
# MONNIFY_ENV=production
# MONNIFY_BASE_URL=https://app.monnify.com

# ─────────────────────────────────────────────
# Transport
# stdio → Claude Code local mode (default)
# http  → Persistent remote server for team/production deployments
# ─────────────────────────────────────────────
TRANSPORT=stdio
PORT=3000

# ─────────────────────────────────────────────
# Security guards
# ─────────────────────────────────────────────

# Restrict which tool categories are registered.
# Options: collections, directDebit, verification, utilities
# Unset = all categories enabled.
# Example (read-only): MONNIFY_ALLOWED_OPERATIONS=verification,utilities
# MONNIFY_ALLOWED_OPERATIONS=

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
